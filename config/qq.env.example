# Placeholder reference ONLY. Never put real credentials in this project.
# Windows: use the separately provided current-user DPAPI credential utility.
# Linux: load a private external chmod 600 file into the backend environment.
QQBOT_APP_ID=<QQBOT_APP_ID>
QQBOT_APP_SECRET=<QQBOT_APP_SECRET>
# Optional: absolute directory OUTSIDE project, current-user-only access.
# QQBOT_PRIVATE_DIR=<PRIVATE_EXTERNAL_STATE_DIRECTORY>
# Multi-bot mode is populated IN MEMORY by the private DPAPI loader.
# Shape only; never copy real secrets here or into command history:
# QQBOT_BOTS=[{"slot":"bot-1","appId":"<BOT1_APP_ID>","appSecret":"<BOT1_APP_SECRET>"},{"slot":"bot-2","appId":"<BOT2_APP_ID>","appSecret":"<BOT2_APP_SECRET>"}]
